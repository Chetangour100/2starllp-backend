NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/payroll
MONGODB_DB_NAME=payroll

# =====================================================
# FORGOT PASSWORD — OTP EMAIL (Gmail)
#
# Yahan apna Gmail address aur "App Password" daalein
# (apna normal Gmail password NAHI — Google App Password
# alag hoti hai).
#
# App Password kaise banayein:
# 1. https://myaccount.google.com/security par jayein
# 2. "2-Step Verification" ON karein (agar pehle se nahi hai)
# 3. Usi page par "App passwords" search karein
# 4. "Mail" app ke liye ek naya App Password generate karein
# 5. Jo 16-character password mile, usse GMAIL_APP_PASSWORD
#    me (bina space ke) daal dein
#
# Agar yeh values khaali chhodi jayengi, to OTP email nahi
# jayega — system OTP ko sirf server console aur (development
# mode me) forgot-password screen par dikha dega, taaki
# bina email setup ke bhi testing ho sake.
# =====================================================

GMAIL_USER=
GMAIL_APP_PASSWORD=
